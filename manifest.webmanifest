{
  "id": "/",
  "name": "Fawran Tools | فورا.tools",
  "short_name": "Fawran",
  "description": "Free bilingual browser tools for images, PDF, SEO, text, websites, email, video and YouTube.",
  "lang": "ar",
  "dir": "auto",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0f0e16",
  "theme_color": "#4F3FF0",
  "categories": ["utilities", "productivity"],
  "icons": [
    {
      "src": "/assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Image Compressor",
      "short_name": "Compress Images",
      "url": "/tools/image-compressor",
      "icons": [{"src": "/assets/icons/icon-192.png", "sizes": "192x192"}]
    },
    {
      "name": "PDF Merger",
      "short_name": "Merge PDF",
      "url": "/tools/pdf-merge",
      "icons": [{"src": "/assets/icons/icon-192.png", "sizes": "192x192"}]
    },
    {
      "name": "Word Counter",
      "short_name": "Count Words",
      "url": "/tools/word-counter",
      "icons": [{"src": "/assets/icons/icon-192.png", "sizes": "192x192"}]
    },
    {
      "name": "SEO Audit",
      "short_name": "SEO Audit",
      "url": "/tools/seo-audit",
      "icons": [{"src": "/assets/icons/icon-192.png", "sizes": "192x192"}]
    }
  ],
  "prefer_related_applications": false
}
